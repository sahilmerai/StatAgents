import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import time

# Load the dataset
file_path = '../data/Raw_data/student_scores Dataset.csv'
df = pd.read_csv(file_path)

# Create a scatter plot to show the relationship between study hours and scores
plt.figure(figsize=(10, 6))
sns.scatterplot(data=df, x='Hours', y='Scores', color='blue', s=100, edgecolor='black')
plt.title('Relationship between Study Hours and Scores')
plt.xlabel('Study Hours')
plt.ylabel('Scores')
plt.grid(True, alpha=0.3)
plt.xlim(0, 10)
plt.ylim(0, 100)
# Save the figure
plt.savefig('../data/Output/Plots/study_hours_vs_scores.png', dpi=300, bbox_inches='tight')
plt.close()

