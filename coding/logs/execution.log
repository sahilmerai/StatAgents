# Calculate average transaction amount and transaction count by hour
average_amount_by_hour = df.groupby('transaction_hour')['amount'].mean()  # Average transaction amount
transaction_count_by_hour = df.groupby('transaction_hour')['transaction_id'].count()  # Transaction count

# Prepare data for visualization
trends_data = pd.DataFrame({
    'Average Amount': average_amount_by_hour,
    'Transaction Count': transaction_count_by_hour
})

# Visualize the data
plt.figure(figsize=(14, 7))
plt.plot(trends_data.index, trends_data['Average Amount'], label='Average Transaction Amount', marker='o')
plt.bar(trends_data.index, trends_data['Transaction Count'], color='lightgray', alpha=0.7, label='Transaction Count')

# Chart details
plt.title('Transaction Trends by Hour of Day')
plt.xlabel('Hour of Day')
plt.ylabel('Amounts and Counts')
plt.xticks(trends_data.index)
plt.grid(alpha=0.3)
plt.legend()
plt.tight_layout()
plt.savefig('./data/Output/Plots/transaction_trends_hour.png')
plt.close()

