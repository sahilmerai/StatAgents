a record.\n\nDo not include information where the supporting evidence for it is not provided.\n\nLimit the total report length to 2500 words.\n\nOutput:", "role": "user"}], "parameters": {"model": "gpt-4o-mini", "frequency_penalty": 0.0, "max_tokens": 4000, "n": 1, "presence_penalty": 0.0, "temperature": 0.0, "top_p": 1.0, "response_format": {"type": "json_object"}}}, "key": "chat_create_community_report_06f258367e9b91bdffb9692cecc6cad7f36e48a8db70d1cf28fa5a36c6a1f0f0_v2"}